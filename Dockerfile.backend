FROM postgres:17-bookworm AS postgres_tools

FROM node:20-bookworm-slim

WORKDIR /app

COPY package.json package-lock.json ./
COPY packages/backend/package.json packages/backend/package-lock.json ./packages/backend/
COPY packages/frontend/package.json packages/frontend/package-lock.json ./packages/frontend/

COPY --from=postgres_tools /usr/lib/postgresql/17 /usr/lib/postgresql/17
COPY --from=postgres_tools /usr/lib/x86_64-linux-gnu/libpq.so* /usr/lib/x86_64-linux-gnu/

# Register PostgreSQL shared libraries so pg_dump can find libpq.so and friends at runtime
RUN echo "/usr/lib/postgresql/17/lib" > /etc/ld.so.conf.d/postgresql.conf && ldconfig

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates default-mysql-client \
  && rm -rf /var/lib/apt/lists/*

RUN npm ci --include=dev

COPY . .

ENV NODE_ENV=production
ENV PORT=3000
ENV PATH="/usr/lib/postgresql/17/bin:${PATH}"

RUN chmod +x /app/docker-entrypoint.sh \
  && mkdir -p /app/backups /app/packages/backend/public /app/packages/backend/uploads /app/packages/backend/logs

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=5 CMD node -e "const http=require('http');const port=Number(process.env.PORT||3000);const req=http.get({host:'127.0.0.1',port,path:'/health',timeout:4000},res=>process.exit(res.statusCode===200?0:1));req.on('error',()=>process.exit(1));req.on('timeout',()=>{req.destroy();process.exit(1);});"

ENTRYPOINT ["/app/docker-entrypoint.sh"]
CMD ["node", "packages/backend/src/server.js"]
