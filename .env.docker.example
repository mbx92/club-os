DB_HOST=host.docker.internal
DB_PORT=5433
DB_NAME=gym_db
DB_USER=postgres
DB_PASSWORD=password
DB_DIALECT=postgres

BACKEND_PORT=3001
FRONTEND_PORT=8081

JWT_SECRET=change-me
JWT_EXPIRES_IN=2h
REFRESH_TOKEN_SECRET=change-me
REFRESH_TOKEN_EXPIRES_IN=7d

ALLOWED_ORIGINS=https://your-frontend-domain.com,http://localhost:8081,http://127.0.0.1:8081

WAIT_FOR_DB=true
DB_WAIT_TIMEOUT=120
DB_WAIT_INTERVAL=3
MIGRATE_ON_START=true
SEED_ON_START=false

VITE_API_URL=/api/v1
VITE_APP_TITLE=Club OS

# Google Drive backup (credentials — folder/enabled can also be set per tenant in UI)
GOOGLE_DRIVE_BACKUP_ENABLED=false
GOOGLE_DRIVE_BACKUP_REQUIRED=false
GOOGLE_DRIVE_BACKUP_FOLDER_ID=
GOOGLE_DRIVE_BACKUP_FOLDER_URL=
# OAuth (preferred for My Drive) OR service account — set one method:
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_OAUTH_REDIRECT_URI=http://127.0.0.1:8787/oauth2callback
# Path inside container (requires secrets volume mount in docker-compose.yml):
GOOGLE_DRIVE_SERVICE_ACCOUNT_KEY_FILE=packages/backend/src/secrets/your-service-account.json
# GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
GOOGLE_DRIVE_SECRETS_DIR=./packages/backend/src/secrets

# MinIO / S3-compatible backup
MINIO_BACKUP_ENABLED=false
MINIO_BACKUP_REQUIRED=false
MINIO_BACKUP_ENDPOINT=https://s3.example.com
MINIO_BACKUP_REGION=us-east-1
MINIO_BACKUP_BUCKET=your-backup-bucket
MINIO_BACKUP_ACCESS_KEY=
MINIO_BACKUP_SECRET_KEY=
MINIO_BACKUP_OBJECT_PREFIX=club-os
MINIO_BACKUP_FORCE_PATH_STYLE=true
MINIO_BACKUP_USE_SSL=true

# Optional: tenant whose backup settings drive scheduled auto-backup
AUTO_BACKUP_TENANT_ID=
