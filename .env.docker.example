DB_HOST=host.docker.internal
DB_PORT=5433
DB_NAME=gym_db
DB_USER=postgres
DB_PASSWORD=password
DB_DIALECT=postgres

BACKEND_PORT=3001
FRONTEND_PORT=8081

JWT_SECRET=change-me
JWT_EXPIRES_IN=2h
REFRESH_TOKEN_SECRET=change-me
REFRESH_TOKEN_EXPIRES_IN=7d

ALLOWED_ORIGINS=https://your-frontend-domain.com,http://localhost:8081,http://127.0.0.1:8081

WAIT_FOR_DB=true
DB_WAIT_TIMEOUT=120
DB_WAIT_INTERVAL=3
MIGRATE_ON_START=true
SEED_ON_START=false

VITE_API_URL=/api/v1
VITE_APP_TITLE=Club OS
