	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Auto-refresh jwt_token if needed",
					"const jwt_tokenExpiry = pm.environment.get('jwt_tokenExpiry');",
					"const now = new Date().getTime();",
					"",
					"if (jwt_tokenExpiry && now > jwt_tokenExpiry) {",
					"    console.log('jwt_token expired, need to re-login');",
					"}"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Auto-save important IDs from responses",
					"if (pm.response.code === 200 || pm.response.code === 201) {",
					"    try {",
					"        const jsonData = pm.response.json();",
					"        ",
					"        // Save categoryId",
					"        if (jsonData.data && jsonData.data.id && pm.request.url.path.includes('categories')) {",
					"            pm.environment.set('categoryId', jsonData.data.id);",
					"        }",
					"        ",
					"        // Save productId",
					"        if (jsonData.data && jsonData.data.id && pm.request.url.path.includes('products')) {",
					"            pm.environment.set('productId', jsonData.data.id);",
					"        }",
					"        ",
					"        // Save purchaseId",
					"        if (jsonData.data && jsonData.data.id && pm.request.url.path.includes('purchases')) {",
					"            pm.environment.set('purchaseId', jsonData.data.id);",
					"        }",
					"        ",
					"        // Save saleId",
					"        if (jsonData.data && jsonData.data.id && pm.request.url.path.includes('sales')) {",
					"            pm.environment.set('saleId', jsonData.data.id);",
					"        }",
					"    } catch (e) {",
					"        console.log('Response not JSON or error parsing:', e);",
					"    }",
					"}"
				]
			}
		}
	],
