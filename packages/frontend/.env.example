# Development: use a relative API URL so devices on the same network can reach the API through Vite.
VITE_API_URL=/api/v1
# Development only: where Vite should proxy API requests.
VITE_API_PROXY_TARGET=http://localhost:3000
VITE_APP_TITLE=ERP System
# Debug mode: true = enable console logs and dev features like "Jawab Acak" button
# In development: defaults to true unless explicitly set to false
# In production: defaults to false unless explicitly set to true
VITE_DEBUG=false
