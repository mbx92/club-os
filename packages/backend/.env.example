# Environment Configuration Template
# Copy this file to .env.development, .env.test, or .env.production
# and update the values accordingly

# Environment
NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gym_db
DB_USER=postgres
DB_PASSWORD=password
DB_DIALECT=postgres

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=2h

# Refresh Token
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
REFRESH_TOKEN_EXPIRES_IN=7d

# Optional: Google Drive upload for DB backups
GOOGLE_DRIVE_BACKUP_ENABLED=false
GOOGLE_DRIVE_BACKUP_REQUIRED=false
GOOGLE_DRIVE_BACKUP_FOLDER_ID=your_google_drive_folder_id
# Alternative to FOLDER_ID if you prefer pasting the full folder URL
GOOGLE_DRIVE_BACKUP_FOLDER_URL=
# Choose one credential method below:
# Preferred for normal My Drive uploads:
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_OAUTH_REDIRECT_URI=http://127.0.0.1:8787/oauth2callback
GOOGLE_DRIVE_SERVICE_ACCOUNT_KEY_FILE=
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_DRIVE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Optional: S3-compatible upload for DB backups (MinIO)
MINIO_BACKUP_ENABLED=false
MINIO_BACKUP_REQUIRED=false
MINIO_BACKUP_ENDPOINT=http://127.0.0.1:9000
MINIO_BACKUP_REGION=us-east-1
MINIO_BACKUP_BUCKET=database-backups
MINIO_BACKUP_ACCESS_KEY=
MINIO_BACKUP_SECRET_KEY=
MINIO_BACKUP_OBJECT_PREFIX=
MINIO_BACKUP_FORCE_PATH_STYLE=true
MINIO_BACKUP_USE_SSL=false

# Optional: fallback GlitchTip / Sentry-compatible DSN for backend-level errors
# Used when an error happens outside tenant context (for example during boot or process crash)
GLITCHTIP_ENABLED=false
GLITCHTIP_DSN=
GLITCHTIP_SERVER_URL=
GLITCHTIP_ENVIRONMENT=development
GLITCHTIP_PROJECT_SLUG=backend
