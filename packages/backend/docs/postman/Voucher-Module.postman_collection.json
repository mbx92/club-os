				{
					"name": "Create Tenant Voucher (Percentage)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    const response = pm.response.json();",
									"    if (response.success && response.data.voucher.id) {",
									"        pm.collectionVariables.set('voucher_id', response.data.voucher.id);",
									"        pm.collectionVariables.set('voucher_code', response.data.voucher.code);",
									"        console.log('✅ Voucher ID saved:', response.data.voucher.id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"code\": \"GYM2025DISC\",\n  \"name\": \"New Year Discount 2025\",\n  \"description\": \"Special discount for new year promotion\",\n  \"type\": \"percentage\",\n  \"value\": 20,\n  \"maxDiscountAmount\": 100000,\n  \"minPurchaseAmount\": 500000,\n  \"applicableTo\": \"membership\",\n  \"applicableItems\": [],\n  \"startDate\": \"2025-01-01T00:00:00.000Z\",\n  \"endDate\": \"2025-01-31T23:59:59.999Z\",\n  \"usageLimit\": 100,\n  \"userUsageLimit\": 1,\n  \"isActive\": true,\n  \"isPublic\": true\n}"
						},
						"url": {
							"raw": "{{base_url}}/vouchers",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"vouchers"
							]
						},
						"description": "Create tenant voucher for membership (percentage discount)"
					},
					"response": []
				},
