				{
					"name": "Create Trainer",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    const response = pm.response.json();",
									"    if (response.success && response.data.trainer.id) {",
									"        pm.collectionVariables.set('trainer_id', response.data.trainer.id);",
									"        console.log('✅ Trainer ID saved:', response.data.trainer.id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Smith\",\n  \"email\": \"john.trainer@gym.com\",\n  \"phone\": \"081234567890\",\n  \"dateOfBirth\": \"1985-05-15\",\n  \"gender\": \"male\",\n  \"specializations\": [\"yoga\", \"personal_training\", \"spinning\"],\n  \"certifications\": [\n    {\n      \"name\": \"Certified Personal Trainer\",\n      \"issuer\": \"NASM\",\n      \"date\": \"2020-01-15\",\n      \"expiryDate\": \"2025-01-15\"\n    }\n  ],\n  \"bio\": \"Experienced trainer with 10+ years in fitness industry\",\n  \"photoUrl\": \"https://example.com/photos/john.jpg\",\n  \"commissionType\": \"percentage\",\n  \"commissionValue\": 15.00,\n  \"commissionNotes\": \"15% of class fees\",\n  \"availability\": {\n    \"monday\": [\"09:00-12:00\", \"14:00-18:00\"],\n    \"tuesday\": [\"09:00-12:00\", \"14:00-18:00\"],\n    \"wednesday\": [\"09:00-12:00\", \"14:00-18:00\"],\n    \"thursday\": [\"09:00-12:00\", \"14:00-18:00\"],\n    \"friday\": [\"09:00-12:00\", \"14:00-18:00\"]\n  },\n  \"hireDate\": \"2024-01-01\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/gym/trainers",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"gym",
								"trainers"
							]
						},
						"description": "Create new trainer with auto-create user account. Returns temp password (development only)"
					},
					"response": []
				},
