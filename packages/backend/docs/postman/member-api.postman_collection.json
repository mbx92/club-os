      "response": []
    },
    {
      "name": "Test - Get Non-existent Member (Error)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/gym/members/00000000-0000-0000-0000-000000000000",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "gym", "members", "00000000-0000-0000-0000-000000000000"]
        },
