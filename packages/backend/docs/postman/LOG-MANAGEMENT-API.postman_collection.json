    {
      "name": "Export",
      "item": [
        {
          "name": "Export Logs to JSON",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/logs/export?level=error&startDate=2025-11-20",
              "host": ["{{base_url}}"],
              "path": ["logs", "export"],
              "query": [
                {
                  "key": "level",
                  "value": "error",
                  "description": "Filter by level"
                },
                {
                  "key": "action",
                  "value": "",
                  "description": "Filter by action",
                  "disabled": true
                },
                {
                  "key": "userId",
                  "value": "",
                  "description": "Filter by user",
                  "disabled": true
                },
                {
                  "key": "search",
                  "value": "",
                  "description": "Search text",
                  "disabled": true
                },
                {
                  "key": "startDate",
                  "value": "2025-11-20",
                  "description": "Start date"
                },
                {
                  "key": "endDate",
                  "value": "",
                  "description": "End date",
                  "disabled": true
                },
                {
                  "key": "filterTenantId",
                  "value": "",
                  "description": "Tenant filter (Super Admin)",
                  "disabled": true
                }
              ]
            },
            "description": "Export filtered logs to JSON file (max 10,000 records). File will be downloaded with filename: logs-export-{timestamp}.json"
          },
          "response": []
        }
