    {
      "name": "Cleanup & Delete",
      "item": [
        {
          "name": "Manual Cleanup - Delete Old Logs",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"days\": 7\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/logs/cleanup",
              "host": ["{{base_url}}"],
              "path": ["logs", "cleanup"]
            },
            "description": "Manually delete logs older than specified days. Default is 7 days. This operation is also run automatically daily at 2:00 AM."
          },
          "response": [
            {
              "name": "Success - Cleanup",
              "originalRequest": {
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"days\": 7\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{base_url}}/logs/cleanup",
                  "host": ["{{base_url}}"],
                  "path": ["logs", "cleanup"]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [],
              "cookie": [],
              "body": "{\n  \"message\": \"Successfully deleted 1250 logs older than 7 days\",\n  \"deletedCount\": 1250\n}"
            }
          ]
        },
        {
          "name": "Cleanup - Super Admin (All Tenants)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"days\": 7\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/logs/cleanup",
              "host": ["{{base_url}}"],
              "path": ["logs", "cleanup"]
            },
            "description": "Super Admin: Cleanup logs for ALL tenants (no filterTenantId specified)"
          },
          "response": []
        },
        {
          "name": "Cleanup - Specific Tenant (Super Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"days\": 7,\n  \"filterTenantId\": \"{{tenant_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/logs/cleanup",
              "host": ["{{base_url}}"],
              "path": ["logs", "cleanup"]
            },
            "description": "Super Admin: Cleanup logs for specific tenant only"
          },
          "response": []
        },
        {
          "name": "Delete Specific Logs",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"logIds\": [\n    \"{{log_id_1}}\",\n    \"{{log_id_2}}\",\n    \"{{log_id_3}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/logs",
              "host": ["{{base_url}}"],
              "path": ["logs"]
            },
            "description": "Delete specific logs by their IDs. Provide an array of log UUIDs."
          },
          "response": [
            {
              "name": "Success - Delete",
              "originalRequest": {
                "method": "DELETE",
                "header": [],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"logIds\": [\"uuid-1\", \"uuid-2\"]\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{base_url}}/logs",
                  "host": ["{{base_url}}"],
                  "path": ["logs"]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [],
              "cookie": [],
              "body": "{\n  \"message\": \"Successfully deleted 2 log(s)\",\n  \"deletedCount\": 2\n}"
            }
          ]
        }
      ],
      "description": "Manual log cleanup and deletion operations"
    }
