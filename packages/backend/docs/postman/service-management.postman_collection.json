				{
					"name": "Create Membership Plan (Time-based)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    const jsonData = pm.response.json();",
									"    pm.collectionVariables.set('servicePlanId', jsonData.data.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"serviceType\": \"membership\",\n  \"name\": \"30 Days Gym Membership\",\n  \"description\": \"Full gym access for 30 days including all facilities\",\n  \"price\": 500000,\n  \"currency\": \"IDR\",\n  \"durationType\": \"time_based\",\n  \"duration\": 30,\n  \"accessControl\": {\n    \"facilities\": [\"gym\", \"pool\", \"sauna\"],\n    \"accessHours\": {\n      \"monday\": [\"06:00\", \"22:00\"],\n      \"tuesday\": [\"06:00\", \"22:00\"],\n      \"wednesday\": [\"06:00\", \"22:00\"],\n      \"thursday\": [\"06:00\", \"22:00\"],\n      \"friday\": [\"06:00\", \"22:00\"],\n      \"saturday\": [\"08:00\", \"20:00\"],\n      \"sunday\": [\"08:00\", \"20:00\"]\n    },\n    \"maxCheckIns\": 30\n  },\n  \"isActive\": true,\n  \"isPopular\": true,\n  \"displayOrder\": 1\n}"
						},
						"url": {
							"raw": "{{base_url}}/service/plans",
							"host": ["{{base_url}}"],
							"path": ["service", "plans"]
						}
