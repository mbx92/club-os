				{
					"name": "List Service Plans",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/service/plans?page=1&limit=10&serviceType=all&isActive=all&sortBy=displayOrder&sortOrder=ASC",
							"host": ["{{base_url}}"],
							"path": ["service", "plans"],
							"query": [
								{
									"key": "page",
									"value": "1",
									"description": "Page number"
								},
								{
									"key": "limit",
									"value": "10",
									"description": "Items per page"
								},
								{
									"key": "search",
									"value": "",
									"description": "Search by name or description",
									"disabled": true
								},
								{
									"key": "serviceType",
									"value": "all",
									"description": "Filter by type: membership, class_package, pt_package, spa_package, custom, all"
								},
								{
									"key": "isActive",
									"value": "all",
									"description": "Filter by active status: true, false, all"
								},
								{
									"key": "sortBy",
									"value": "displayOrder",
									"description": "Sort field: name, price, displayOrder, createdAt, serviceType"
								},
								{
									"key": "sortOrder",
									"value": "ASC",
									"description": "Sort order: ASC, DESC"
								}
							]
						}
					},
					"response": []
				},
