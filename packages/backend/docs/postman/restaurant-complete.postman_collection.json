{
	"info": {
		"_postman_id": "restaurant-complete-2025",
		"name": "Restaurant Module Complete API",
		"description": "Complete API collection for Restaurant Module with:\n- Multi-tenant support\n- CASL authorization\n- Feature gating\n- Product catalog with JSONB variants\n- Hierarchical categories\n- Table management\n- Stock tracking\n- Order management with split payment\n- Split bill & merge bills\n- Direct order (quick sale)\n- Combined billing (membership + products)\n- Voucher integration",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "restaurant-complete"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{jwt_token}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"let res = pm.response.json();",
									"if (res.token) {",
									"    pm.environment.set(\"jwt_token\", res.token);",
									"    pm.environment.set(\"authToken\", res.token);",
									"    pm.environment.set(\"refreshToken\", res.refreshToken);",
									"    if (res.user && res.user.tenantId) {",
									"        pm.environment.set(\"tenantId\", res.user.tenantId);",
									"    }",
									"    if (res.user && res.user.id) {",
									"        pm.environment.set(\"userId\", res.user.id);",
									"    }",
									"    console.log(\"✅ Token and user info saved to environment\");",
									"} else {",
									"    console.warn(\"⚠️ No token in response\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{restaurantUserEmail}}\",\n  \"password\": \"{{restaurantUserPassword}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						}
					},
					"response": []
				}
			]
		},
