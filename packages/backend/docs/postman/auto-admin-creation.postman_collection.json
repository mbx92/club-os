{
  "info": {
    "name": "Auto Admin Creation - Tenant Management",
    "description": "Collection untuk testing fitur auto-generate admin saat membuat tenant baru",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Login SuperAdmin",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Save access token to environment",
              "if (pm.response.code === 200) {",
              "    const response = pm.response.json();",
              "    pm.environment.set('superadmin_token', response.accessToken);",
              "    pm.environment.set('superadmin_id', response.user.id);",
              "    console.log('SuperAdmin token saved:', response.accessToken);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"superadmin@gym.com\",\n  \"password\": \"superadmin123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/auth/login",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "auth", "login"]
        }
      },
      "response": []
    },
    {
      "name": "2. Create Tenant (Auto Admin)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Save tenant and admin credentials",
              "if (pm.response.code === 201) {",
              "    const response = pm.response.json();",
              "    pm.environment.set('new_tenant_id', response.tenant.id);",
              "    pm.environment.set('new_admin_email', response.admin.email);",
              "    pm.environment.set('new_admin_password', response.admin.password);",
              "    ",
              "    console.log('Tenant created:', response.tenant.name);",
              "    console.log('Admin email:', response.admin.email);",
              "    console.log('Admin password:', response.admin.password);",
              "    ",
              "    // Test assertions",
              "    pm.test('Status is 201', () => {",
              "        pm.response.to.have.status(201);",
              "    });",
              "    ",
              "    pm.test('Tenant created successfully', () => {",
              "        pm.expect(response.tenant).to.have.property('id');",
              "        pm.expect(response.tenant).to.have.property('domain');",
              "    });",
              "    ",
              "    pm.test('Admin account created', () => {",
              "        pm.expect(response.admin).to.have.property('email');",
              "        pm.expect(response.admin).to.have.property('password');",
              "        pm.expect(response.admin.email).to.include('admin@');",
              "    });",
              "    ",
              "    pm.test('Admin email format correct', () => {",
              "        const domain = response.tenant.domain;",
              "        pm.expect(response.admin.email).to.equal(`admin@${domain}`);",
              "    });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{superadmin_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test Gym Fitness Center\",\n  \"domain\": \"testgym{{$randomInt}}.com\",\n  \"address\": \"Jl. Sudirman No. 123, Jakarta\",\n  \"phone\": \"+6281234567890\",\n  \"email\": \"contact@testgym.com\",\n  \"isActive\": true,\n  \"isOnTrial\": true,\n  \"trialEndDate\": \"2025-12-31\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/tenants",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "tenants"]
        }
      },
      "response": []
    },
    {
      "name": "3. Login as New Admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Save admin token",
              "if (pm.response.code === 200) {",
              "    const response = pm.response.json();",
              "    pm.environment.set('tenant_admin_token', response.accessToken);",
              "    ",
              "    console.log('Admin logged in successfully');",
              "    console.log('Admin token:', response.accessToken);",
              "    ",
              "    // Test assertions",
              "    pm.test('Login successful', () => {",
              "        pm.response.to.have.status(200);",
              "    });",
              "    ",
              "    pm.test('User is not SuperAdmin', () => {",
              "        pm.expect(response.user.isSuperAdmin).to.be.false;",
              "    });",
              "    ",
              "    pm.test('User has correct tenant', () => {",
              "        pm.expect(response.user.tenantId).to.equal(pm.environment.get('new_tenant_id'));",
              "    });",
              "    ",
              "    pm.test('User role is admin', () => {",
              "        pm.expect(response.user.role.name).to.equal('admin');",
              "    });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{new_admin_email}}\",\n  \"password\": \"{{new_admin_password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/auth/login",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "auth", "login"]
        }
      },
      "response": []
    },
    {
      "name": "4. Get My Profile (as Admin)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    const response = pm.response.json();",
              "    ",
              "    pm.test('Profile retrieved', () => {",
              "        pm.response.to.have.status(200);",
              "    });",
              "    ",
              "    pm.test('Email matches', () => {",
              "        pm.expect(response.email).to.equal(pm.environment.get('new_admin_email'));",
              "    });",
              "    ",
              "    pm.test('Has tenant association', () => {",
              "        pm.expect(response).to.have.property('tenant');",
              "        pm.expect(response.tenant.id).to.equal(pm.environment.get('new_tenant_id'));",
              "    });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tenant_admin_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/auth/me",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "auth", "me"]
        }
      },
      "response": []
    },
    {
      "name": "5. Get Tenant Details (as Admin)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    const response = pm.response.json();",
              "    ",
              "    pm.test('Can access own tenant', () => {",
              "        pm.response.to.have.status(200);",
              "        pm.expect(response.id).to.equal(pm.environment.get('new_tenant_id'));",
              "    });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tenant_admin_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/tenants/{{new_tenant_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "tenants", "{{new_tenant_id}}"]
        }
      },
      "response": []
    },
    {
      "name": "6. Verify Admin Cannot Create Tenants",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Tenant admin cannot create tenants', () => {",
              "    pm.expect(pm.response.code).to.be.oneOf([403, 401]);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tenant_admin_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Should Fail\",\n  \"domain\": \"shouldfail.com\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/tenants",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "tenants"]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    }
  ]
}
