{
	"info": {
		"_postman_id": "restaurant-module-2025",
		"name": "Restaurant Module API",
		"description": "Complete API collection for Restaurant Module with multi-tenant support, CASL authorization, and feature gating. Includes product catalog with JSONB variants, hierarchical categories, table management, and stock tracking.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "restaurant-module"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{jwt_token}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"let res = pm.response.json();",
									"if (res.token) {",
									"    pm.environment.set(\"jwt_token\", res.token);",
									"    pm.environment.set(\"authToken\", res.token);",
									"    pm.environment.set(\"refreshToken\", res.refreshToken);",
									"    if (res.user && res.user.tenantId) {",
									"        pm.environment.set(\"tenantId\", res.user.tenantId);",
									"    }",
									"    if (res.user && res.user.id) {",
									"        pm.environment.set(\"userId\", res.user.id);",
									"    }",
									"    console.log(\"✅ Token and user info saved to environment\");",
									"} else {",
									"    console.warn(\"⚠️ No token in response\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{restaurantUserEmail}}\",\n  \"password\": \"{{restaurantUserPassword}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						}
					},
					"response": []
				},
				{
					"name": "Refresh Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.environment.set(\"authToken\", jsonData.token);",
									"    pm.environment.set(\"jwt_token\", jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/refresh-token",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"refresh-token"
							]
						}
					},
					"response": []
				}
			]
		},
