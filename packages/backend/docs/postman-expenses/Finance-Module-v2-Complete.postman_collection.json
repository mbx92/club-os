              "host": ["{{baseUrl}}"],
              "path": ["finance", "cash-flow", "by-category"],
              "query": [
                { "key": "startDate", "value": "2025-01-01", "description": "Required" },
                { "key": "endDate", "value": "2025-12-31", "description": "Required" },
                { "key": "locationId", "value": "{{locationId}}", "disabled": true },
                { "key": "type", "value": "inflow", "disabled": true, "description": "inflow or outflow" }
              ]
            },
            "description": "Get cash flow breakdown by inflow/outflow categories"
          },
          "response": []
        },
