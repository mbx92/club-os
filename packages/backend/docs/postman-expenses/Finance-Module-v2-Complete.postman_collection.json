    {
      "name": "Cash Flow Management",
      "item": [
        {
          "name": "Get Cash Flow Summary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/finance/cash-flow/summary?startDate=2025-01-01&endDate=2025-12-31&groupBy=month",
              "host": ["{{baseUrl}}"],
              "path": ["finance", "cash-flow", "summary"],
              "query": [
                { "key": "startDate", "value": "2025-01-01", "description": "Required" },
                { "key": "endDate", "value": "2025-12-31", "description": "Required" },
                { "key": "locationId", "value": "{{locationId}}", "disabled": true },
                { "key": "groupBy", "value": "month", "description": "day, week, month, year" }
              ]
            },
            "description": "Get cash flow summary with inflows, outflows, net flow, and running balance"
          },
          "response": []
        },
        {
          "name": "Get Cash Flow by Category",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
