  "item": [
    {
      "name": "Income Management",
      "item": [
        {
          "name": "Create Manual Income",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": \"{{incomeCategoryId}}\",\n  \"locationId\": \"{{locationId}}\",\n  \"title\": \"Donation from Corporate Sponsor\",\n  \"description\": \"Annual sponsorship donation\",\n  \"amount\": 5000000,\n  \"taxAmount\": 0,\n  \"incomeDate\": \"2025-01-15\",\n  \"receivedDate\": \"2025-01-15\",\n  \"paymentMethod\": \"transfer\",\n  \"referenceNumber\": \"DON-2025-001\",\n  \"source\": \"PT ABC Corporation\",\n  \"status\": \"received\",\n  \"isRecurring\": true,\n  \"recurringFrequency\": \"yearly\",\n  \"recurringEndDate\": \"2030-01-15\",\n  \"notes\": \"Corporate sponsorship agreement\",\n  \"tags\": [\"donation\", \"corporate\", \"annual\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/finance/incomes",
              "host": ["{{baseUrl}}"],
              "path": ["finance", "incomes"]
            },
            "description": "Create a manual income entry (non-transactional)"
          },
          "response": []
        },
        {
          "name": "Get All Incomes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/finance/incomes?page=1&limit=20&type=manual&startDate=2025-01-01&endDate=2025-12-31&sortBy=incomeDate&sortOrder=DESC",
              "host": ["{{baseUrl}}"],
              "path": ["finance", "incomes"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "type", "value": "manual", "description": "Filter: manual or transactional" },
                { "key": "status", "value": "received", "disabled": true },
                { "key": "categoryId", "value": "{{incomeCategoryId}}", "disabled": true },
                { "key": "locationId", "value": "{{locationId}}", "disabled": true },
                { "key": "startDate", "value": "2025-01-01" },
                { "key": "endDate", "value": "2025-12-31" },
                { "key": "search", "value": "", "disabled": true },
                { "key": "sortBy", "value": "incomeDate" },
                { "key": "sortOrder", "value": "DESC" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Income by ID",
          "request": {
            "method": "GET",
