              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Donation Title\",\n  \"amount\": 5500000,\n  \"notes\": \"Amount increased due to contract amendment\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/finance/incomes/{{incomeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["finance", "incomes", "{{incomeId}}"]
