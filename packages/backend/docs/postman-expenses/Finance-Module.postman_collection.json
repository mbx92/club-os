        {
          "name": "Create Expense",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.environment.set('expenseId', response.data.id);",
                  "    pm.test('Expense created successfully', () => {",
                  "        pm.expect(response.success).to.be.true;",
                  "        pm.expect(response.data).to.have.property('id');",
                  "        pm.expect(response.data).to.have.property('expenseNumber');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": \"{{categoryId}}\",\n  \"title\": \"Monthly Office Rent\",\n  \"description\": \"Office space rental for December 2025\",\n  \"amount\": 15000000,\n  \"taxAmount\": 1500000,\n  \"expenseDate\": \"2025-12-22\",\n  \"dueDate\": \"2025-12-31\",\n  \"paymentMethod\": \"transfer\",\n  \"vendor\": \"PT Property Management\",\n  \"status\": \"pending\",\n  \"notes\": \"Payment due end of month\",\n  \"tags\": [\"rent\", \"fixed-cost\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/finance/expenses",
              "host": ["{{baseUrl}}"],
              "path": ["finance", "expenses"]
            },
            "description": "Create a new expense record.\n\n**Fields:**\n- `categoryId` (required): Expense category UUID\n- `title` (required): Expense title\n- `amount` (required): Base amount\n- `taxAmount`: Tax/VAT amount\n- `expenseDate` (required): Date of expense\n- `dueDate`: Payment due date\n- `status`: draft|pending|approved|paid|cancelled\n- `paymentMethod`: cash|transfer|credit_card|debit_card|check|other\n- `vendor`: Vendor/supplier name\n- `isRecurring`: Boolean for recurring expense\n- `recurringFrequency`: daily|weekly|monthly|quarterly|yearly"
          },
          "response": []
        },
        {
          "name": "Get All Expenses",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Get expenses successful', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.success).to.be.true;",
                  "    pm.expect(response.data).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
