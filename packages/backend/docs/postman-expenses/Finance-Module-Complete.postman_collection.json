        {
          "name": "Expense Report",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/finance/reports/expenses?startDate=2025-12-01&endDate=2025-12-31",
              "host": ["{{baseUrl}}"],
              "path": ["finance", "reports", "expenses"],
              "query": [
                {
                  "key": "startDate",
                  "value": "2025-12-01"
                },
                {
                  "key": "endDate",
                  "value": "2025-12-31"
                }
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
