# ==============================================================
# .env.local.example
# Local node configuration – copy to .env.local and customize
# ==============================================================

# ── App ──────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Local PostgreSQL ──────────────────────────────────────────
DB_HOST=db
DB_PORT=5432
DB_USER=gym_local
DB_PASSWORD=change_me_strong_password
DB_NAME=gym_local_db
DB_DIALECT=postgres

# ── Local node identity ───────────────────────────────────────
# Enables offline queue and sync job
IS_LOCAL_NODE=true

# Identifier shown in sync logs (use a short location label)
LOCAL_NODE_ID=lt1-frontdesk

# ── Main server (Lt. 2) ───────────────────────────────────────
# LAN IP address of the main server's backend API
MAIN_SERVER_URL=http://192.168.1.10:3000

# Shared secret between local node and main server.
# Must be identical in both .env files.
# Generate with: openssl rand -hex 32
SYNC_SECRET=replace_with_64_char_random_hex

# ── Auth (same as main server) ────────────────────────────────
JWT_SECRET=same_jwt_secret_as_main_server

# ── (Optional) pgAdmin ───────────────────────────────────────
PGADMIN_PASSWORD=admin
