source_file": "packages/backend/docs/plan/00-OVERVIEW.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "packages_backend_docs_plan_00_overview_multitenancy", "label": "Multi-Tenancy Isolation", "file_type": "concept", "source_file": "packages/backend/docs/plan/00-OVERVIEW.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "packages_backend_docs_plan_00_overview_feature_gating_approach_decision", "label": "Feature-Gating Approach Decision", "file_type": "rationale", "source_file": "packages/backend/docs/plan/00-OVERVIEW.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Middleware-based validation against SubscriptionPlan.features chosen for reusability across routes and centralized logic; rejected alternatives were controller-level checking (too repetitive) and frontend-only gating (not secure)."}, {"id": "packages_backend_docs_plan_00_overview_multimode_decision", "label": "Multi-Mode Simultaneous Tenant Modules Decision", "file_type": "rationale", "source_file": "packages/backend/docs/plan/00-OVERVIEW.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tenant.modules JSON allows gym+POS+restaurant to run simultaneously rather than exclusively, enabling hybrid business models and more revenue streams."}, {"id": "packages_backend_docs_plan_00_overview_printer_per_station_decision", "label": "Per-Station Printer Configuration Decision", "file_type": "rationale", "source_file": "packages/backend/docs/plan/00-OVERVIEW.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PrinterDevice model configured per-station with tenant admin control, since one tenant may have multiple locations/POS stations and admins should self-manage printer setup without superadmin intervention."}, {"id": "packages_backend_docs_plan_00_overview_transaction_architecture_decision", "label": "Maintain Existing Transaction Architecture Decision", "file_type": "rationale", "source_file": "packages/backend/docs/plan/00-OVERVIEW.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keep the existing Transaction model and expand the polymorphic TransactionItem rather than rewriting, since the system is already proven and this preserves backward compatibility with MembershipPayment."}, {"id": "packages_backend_docs_plan_00_overview_sequence_management_decision", "label": "Database-Backed Sequence Management Decision", "file_type": "rationale", "source_file": "packages/backend/docs/plan/00-OVERVIEW.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SequenceCounter model chosen over in-memory counters for reliability across restarts, better race-condition prevention via pessimistic locking, and easier auditing/monitoring."}, {"id": "packages_backend_docs_plan_00_overview_third_party_security_decision", "label": "Third-Party Credential Encryption Decision", "file_type": "rationale", "source_file": "packages/backend/docs/plan/00-OVERVIEW.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "At-rest encryption with tenant-specific keys chosen for security compliance, isolating credentials between tenants and mitigating leakage risk on database breach."}], "edges": [{"source": "packages_backend_docs_plan_00_overview", "target": "packages_backend_docs_plan_phase_01_subscription_features", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/backend/docs/plan/00-OVERVIEW.md", "source_location": null, "weight": 1.0}, {"source": "packages_backend_docs_plan_00_overview", "target": "pack