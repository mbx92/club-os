{"nodes": [{"id": "packages_frontend_docs_report_psy_test_usage_billing_report", "label": "Test Usage Billing Report API Specification", "file_type": "document", "source_file": "packages/frontend/docs/report psy/TEST-USAGE-BILLING-REPORT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_test_usage_billing_endpoint", "label": "GET /api/v1/psychology/reports/test-usage-billing endpoint", "file_type": "concept", "source_file": "packages/frontend/docs/report psy/TEST-USAGE-BILLING-REPORT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_session_based_billing", "label": "Session-based (vs Order-based) Billing Report", "file_type": "rationale", "source_file": "packages/frontend/docs/report psy/TEST-USAGE-BILLING-REPORT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Session-based reporting was chosen over order-based because a single order can bundle multiple tests (e.g. a package of CFIT+PAPI+EPPS), so counting at order level undercounts actual test usage; sessions also carry per-test verified/unverified status, a completion timestamp (`completedAt`, more accurate than `createdAt`), and duration \u2014 all needed for accurate per-test invoicing, quality control, and client dispute resolution."}], "edges": [{"source": "packages_frontend_docs_report_psy_test_usage_billing_report", "target": "concept_test_usage_billing_endpoint", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/frontend/docs/report psy/TEST-USAGE-BILLING-REPORT.md", "source_location": null, "weight": 1.0}, {"source": "packages_frontend_docs_report_psy_test_usage_billing_report", "target": "concept_session_based_billing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "packages/frontend/doc