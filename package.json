{
  "name": "club-os",
  "version": "1.0.0",
  "private": true,
  "description": "Club OS - Gym Membership & ERP Management System",
  "workspaces": [
    "packages/backend",
    "packages/frontend"
  ],
  "scripts": {
    "dev": "concurrently -n be,fe -c blue,green \"npm run dev -w packages/backend\" \"npm run dev -w packages/frontend\"",
    "dev:be": "npm run dev -w packages/backend",
    "dev:fe": "npm run dev -w packages/frontend",
    "build": "npm run build -w packages/frontend",
    "start:be": "npm run start -w packages/backend",
    "start:be:dev": "npm run start:dev -w packages/backend",
    "start:be:prod": "npm run start:prod -w packages/backend",
    "test": "npm run test -w packages/backend",
    "test:coverage": "npm run test:coverage -w packages/backend",
    "db:migrate": "npm run db:migrate -w packages/backend",
    "db:seed": "npm run db:seed -w packages/backend",
    "db:reset": "npm run db:reset -w packages/backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
